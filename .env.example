# Explanation provider: ollama (default) | claude | mock
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Only used when LLM_PROVIDER=claude. Leave empty unless you have a key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Seconds before an LLM call is abandoned and the template explanation is used
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Below this top-class probability a ticket is flagged needs_human_review
CONFIDENCE_THRESHOLD=0.6
MODEL_PATH=models/triage_model.joblib
PORT=4103
LOG_LEVEL=INFO
